# ================= خزنة جدارة السعودية — قالب الإعدادات =================
# انسخ هذا الملف إلى .env ثم املأ القيم. لا تُرفع .env إلى المستودع أبداً.

# 1) مفتاح التشفير عند السكون (AES-256-GCM) — ٦٤ خانة hex
#    openssl rand -hex 32
VAULT_ENCRYPTION_KEY=

# 2) مفتاح API مشترك بين Base44 والخزنة (X-Vault-Key) — ٦٤ خانة hex
#    openssl rand -hex 32
#    ⚠️ انسخ نفس القيمة إلى أسرار Base44 باسم VAULT_API_KEY
VAULT_API_KEY=

# 3) مفتاح توقيع روابط تنزيل المستندات (اختياري — افتراضياً يستخدم مفتاح التشفير)
#    openssl rand -hex 32
VAULT_JWT_SECRET=

# 4) مدة صلاحية رابط التنزيل بالثواني (افتراضي 300 = ٥ دقائق)
VAULT_DOC_TTL=300

# 5) قاعدة البيانات
PGHOST=localhost
PGPORT=5432
PGUSER=vault
PGPASSWORD=
PGDATABASE=jadara_vault
# فعّلها عند اتصال بقاعدة مُدارة تشترط TLS
PGSSL=false

# 6) مخزن ملفات المستندات — يجب أن يكون حجمًا دائماً (volume) مع نسخ احتياطي
VAULT_STORAGE_DIR=./storage

# 7) منفذ الخدمة (يُكشف عبر reverse proxy مع TLS فقط)
PORT=4000
