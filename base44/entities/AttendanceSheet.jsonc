{
  "name": "AttendanceSheet",
  "type": "object",
  "properties": {
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "period_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0634\u0647\u0631 (YYYY-MM)"
    },
    "year": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0646\u0629"
    },
    "month": {
      "type": "number",
      "title": "\u0627\u0644\u0634\u0647\u0631"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved"
      ],
      "default": "approved",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629"
    },
    "records_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0633\u062c\u0644\u0627\u062a \u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0642\u062a \u0627\u0644\u062d\u0641\u0638"
    },
    "present_count": {
      "type": "number",
      "default": 0,
      "title": "\u062d\u0627\u0636\u0631"
    },
    "late_count": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u062a\u0623\u062e\u0631"
    },
    "absent_count": {
      "type": "number",
      "default": 0,
      "title": "\u063a\u0627\u0626\u0628"
    },
    "leave_count": {
      "type": "number",
      "default": 0,
      "title": "\u0625\u062c\u0627\u0632\u0629"
    },
    "saved_at": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062d\u0641\u0638 \u0627\u0644\u0646\u0633\u062e\u0629"
    },
    "document_ref": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0646\u0633\u062e\u0629 PDF \u0627\u0644\u0645\u0624\u0631\u0634\u0641\u0629 \u0641\u064a \u0627\u0644\u062e\u0632\u0646\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u062d\u064f\u0641\u0638\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645)"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u062d\u064f\u0641\u0638\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u064a\u0645\u064a\u0644)"
    }
  },
  "required": [
    "period_key",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}