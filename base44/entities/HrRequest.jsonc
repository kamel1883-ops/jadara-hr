{
  "name": "HrRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641 \u0645\u0642\u062f\u0651\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641 \u0645\u0642\u062f\u0651\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641 (\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u0648\u0638\u0641)"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "salary_definition",
        "add_health_insurance",
        "iqama_renewal",
        "final_exit",
        "sponsorship_transfer",
        "contract_termination",
        "contract_renewal",
        "no_renewal_request",
        "experience_letter",
        "bank_account_update",
        "other"
      ],
      "default": "other",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0637\u0644\u0628"
    },
    "request_title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0637\u0644\u0628 (\u064a\u064f\u0643\u062a\u0628 \u064a\u062f\u0648\u064a\u0627\u064b \u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u00ab\u0623\u062e\u0631\u0649\u00bb)"
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0637\u0644\u0628 / \u0627\u0644\u0625\u0634\u0643\u0627\u0644\u064a\u0629"
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "attachment_ref": {
      "type": "string",
      "title": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0637\u0644\u0628 (\u0631\u0645\u0632 \u0645\u0633\u062a\u0646\u062f \u0641\u064a \u0627\u0644\u062e\u0632\u0646\u0629)"
    },
    "request_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_hr",
        "approved",
        "rejected"
      ],
      "default": "pending_hr",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "hr_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0645\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0645\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_note": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 / \u0633\u0628\u0628 \u0627\u0644\u0631\u0641\u0636"
    },
    "hr_document_ref": {
      "type": "string",
      "title": "\u0645\u0633\u062a\u0646\u062f \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0639\u062a\u0645\u062f (\u0631\u0645\u0632 \u0641\u064a \u0627\u0644\u062e\u0632\u0646\u0629)"
    },
    "vault_ref": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0633\u062c\u0644 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u062e\u0632\u0646\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629"
    }
  },
  "required": [
    "employee_id",
    "request_type",
    "status"
  ],
  "rls": {
    "create": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    },
    "read": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    },
    "update": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    },
    "delete": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    }
  }
