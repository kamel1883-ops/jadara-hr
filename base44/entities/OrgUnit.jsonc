{
  "name": "OrgUnit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "general_management",
        "executive",
        "department",
        "division",
        "section",
        "unit",
        "supervisor",
        "role",
        "other"
      ],
      "default": "department",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "parent_id": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u0623\u0635\u0644"
    },
    "parent_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u0623\u0635\u0644"
    },
    "manager_name": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0624\u0648\u0644"
    },
    "manager_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u0624\u0648\u0644"
    },
    "planned_headcount": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u062e\u0637\u0637"
    },
    "current_headcount": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0641\u0639\u0644\u064a"
    },
    "level": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0633\u062a\u0648\u0649"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u062a\u0631\u062a\u064a\u0628"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0641\u0648\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "required": [
    "name",
    "unit_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
