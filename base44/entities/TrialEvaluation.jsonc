{
  "name": "TrialEvaluation",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0638\u064a\u0641\u0629"
    },
    "job_title": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0648\u0638\u064a\u0641\u0629"
    },
    "applicant_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062a\u0642\u062f\u0645 / \u0627\u0644\u0645\u0639\u064a\u0651\u0646"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "evaluation_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "competence_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0643\u0641\u0627\u0621\u0629 (1-5)"
    },
    "behavior_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0633\u0644\u0648\u0643 (1-5)"
    },
    "knowledge_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0645\u0639\u0631\u0641\u0629 (1-5)"
    },
    "professional_field_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0645\u062c\u0627\u0644 \u0627\u0644\u0645\u0647\u0646\u064a (1-5)"
    },
    "experience_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u062e\u0628\u0631\u0629 (1-5)"
    },
    "overall_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0643\u0644\u064a (1-5)"
    },
    "strengths": {
      "type": "string",
      "title": "\u0646\u0642\u0627\u0637 \u0627\u0644\u0642\u0648\u0629"
    },
    "improvements": {
      "type": "string",
      "title": "\u0641\u0631\u0635 \u0627\u0644\u062a\u062d\u0633\u064a\u0646"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "confirm",
        "dismiss_probation",
        "extend"
      ],
      "default": "confirm",
      "title": "\u0627\u0644\u062a\u0648\u0635\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "completed",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "required": [
    "employee_name",
    "evaluation_date",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}