    },
    "employees_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u064a\u0646 \u0628\u0627\u0644\u0645\u0646\u0634\u0623\u0629 \u0648\u0642\u062a \u0627\u0644\u0637\u0644\u0628"
