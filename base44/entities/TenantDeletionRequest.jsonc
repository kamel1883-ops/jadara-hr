      "type": "string",
      "title": "\u0627\u0639\u062a\u0645\u062f\u0647 \u0627\u0644\u0645\u0627\u0644\u0643"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
