    "deleted_summary": {
      "type": "string",
      "title": "\u0645\u0644\u062e\u0635 \u0645\u0627 \u062a\u0645 \u062d\u0630\u0641\u0647 (JSON: \u0639\u062f\u062f \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0644\u0643\u0644 \u0643\u064a\u0627\u0646)"
