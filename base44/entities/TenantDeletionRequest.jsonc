      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "contact_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0645\u0642\u062f\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "contact_phone": {
      "type": "string",
