{
  "name": "PresenceProofRequest",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u0651\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "cancelled"
      ],
      "default": "active",
      "title": "\u062d\u0627\u0644\u0629 \u0637\u0644\u0628 \u0625\u062b\u0628\u0627\u062a \u0627\u0644\u062d\u0636\u0648\u0631"
    },
    "scope": {
      "type": "string",
      "enum": [
        "on_shift"
      ],
      "default": "on_shift",
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0627\u0633\u062a\u0647\u062f\u0627\u0641"
    },
    "requested_by_user_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u062d\u0633\u0627\u0628 \u0645\u064f\u0635\u062f\u0631 \u0627\u0644\u0637\u0644\u0628"
    },
    "requested_by_employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0633\u062c\u0644 \u0645\u064f\u0635\u062f\u0631 \u0627\u0644\u0637\u0644\u0628 (\u0625\u0646 \u0643\u0627\u0646 \u0645\u0648\u0638\u0641\u0627\u064b \u0645\u0641\u0648\u0651\u0636\u0627\u064b)"
    },
    "requested_by_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0645\u064f\u0635\u062f\u0631 \u0627\u0644\u0637\u0644\u0628"
    },
    "requested_at": {
      "type": "number",
      "title": "\u0648\u0642\u062a \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0637\u0644\u0628 (timestamp ms)"
    },
    "deadline_at": {
      "type": "number",
      "title": "\u0646\u0647\u0627\u064a\u0629 \u0645\u0647\u0644\u0629 \u0627\u0644\u062a\u0623\u0643\u064a\u062f (timestamp ms)"
    },
    "target_ids": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u064a\u0646 (\u0645\u0635\u0641\u0648\u0641\u0629 JSON)"
    },
    "target_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u064a\u0646"
    },
    "confirmed_ids": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0623\u0643\u0651\u062f\u0648\u0627 (\u0645\u0635\u0641\u0648\u0641\u0629 JSON)"
    },
    "confirmed_log": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u062a\u0623\u0643\u064a\u062f\u0627\u062a (\u0645\u0635\u0641\u0648\u0641\u0629 JSON: employee_id, confirmed_at)"
    },
    "push_status": {
      "type": "string",
      "title": "\u062d\u0627\u0644\u0629 \u0625\u0631\u0633\u0627\u0644 \u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u062c\u0648\u0627\u0644: sent/partial/failed/skipped_no_user"
    },
    "push_sent_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u062c\u0648\u0627\u0644 \u0627\u0644\u0645\u0631\u0633\u0644\u0629"
    },
    "push_failed_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u062c\u0648\u0627\u0644 \u0627\u0644\u0645\u062a\u0639\u0630\u0631\u0629"
    },
    "push_skipped_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u064a\u0646 \u0628\u0644\u0627 \u062d\u0633\u0627\u0628 \u062a\u0637\u0628\u064a\u0642 \u0645\u0631\u062a\u0628\u0637"
    },
    "push_web_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u062c\u0648\u0627\u0644 \u0627\u0644\u0645\u0631\u0633\u0644\u0629 \u0639\u0628\u0631 \u0627\u0634\u062a\u0631\u0627\u0643 \u062f\u0641\u0639 \u0627\u0644\u0648\u064a\u0628"
    },
    "push_web_failed_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062f\u0641\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u0645\u062a\u0639\u0630\u0631\u0629"
    },
    "resend_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0625\u0639\u0627\u062f\u0629 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0644\u0644\u0645\u062a\u0628\u0642\u064a\u0646"
    },
    "last_resend_at": {
      "type": "number",
      "default": 0,
      "title": "\u0648\u0642\u062a \u0622\u062e\u0631 \u0625\u0639\u0627\u062f\u0629 \u0625\u0631\u0633\u0627\u0644 (timestamp ms)"
    }
  },
  "required": [
    "unified_number",
    "status",
    "requested_at",
    "deadline_at",
    "target_ids"
  ],
  "rls": {
    "create": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    },
    "read": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    },
    "update": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    },
    "delete": {
      "data.unified_number": "{{user.data.tenant_unified_number}}"
    }
  }
}