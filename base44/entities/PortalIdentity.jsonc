  "properties": {
    "national_id_hash": {
      "type": "string",
      "title": "\u0628\u0635\u0645\u0629 \u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 (HMAC-SHA256 \u2014 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0631\u0642\u0645 \u0645\u0646\u0647\u0627) \u2014 \u0644\u0644\u0628\u062d\u062b \u0627\u0644\u0641\u0648\u0631\u064a \u0639\u0646\u062f \u0627\u0644\u062f\u062e\u0648\u0644"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u0628\u0635\u0645\u0629"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
