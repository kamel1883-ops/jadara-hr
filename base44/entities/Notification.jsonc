{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "body": {
      "type": "string",
      "title": "\u0627\u0644\u0646\u0635"
    },
    "type": {
      "type": "string",
      "title": "\u0627\u0644\u0646\u0648\u0639",
      "description": "\u0645\u062b\u0627\u0644: attendance (\u062a\u0623\u062e\u064a\u0631/\u063a\u064a\u0627\u0628)\u060c approval\u060c general"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 (\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0644\u0645\u0648\u0638\u0641 \u0628\u0639\u064a\u0646\u0647 \u0641\u064a \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u0648\u0638\u0641)"
    },
    "user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 (\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0644\u062d\u0633\u0627\u0628 Base44 \u2014 \u064a\u0633\u062a\u062e\u062f\u0645\u0647 \u0645\u0639\u062a\u0645\u062f\u0648\u0646 \u0627\u0644\u0628\u0648\u0627\u0628\u0629)"
    },
    "i18n": {
      "type": "string",
      "title": "\u062a\u0631\u062c\u0645\u0627\u062a \u0627\u0644\u0639\u0646\u0648\u0627\u0646/\u0627\u0644\u0646\u0635 (JSON)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629 JSON: {\"ar\":{title,body},\"en\":{...},\"hi\",\"ne\",\"bn\",\"fil\",\"ur\"}"
    },
    "link": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "title": "\u0645\u0642\u0631\u0648\u0621"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "required": [
    "title",
    "is_read"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}