{
  "name": "PlatformSubscription",
  "type": "object",
  "properties": {
    "platform_key": {
      "type": "string",
      "enum": [
        "absher_business",
        "muqeem",
        "ajeer",
        "qiwa",
        "mudad",
        "gosi",
        "tamm",
        "wathq",
