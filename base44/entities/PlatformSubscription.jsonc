        "maroof",
        "etimad",
        "zatca",
        "saudi_business_center",
        "ejar",
        "labor_office",
        "other"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "custom_label": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0635\u0629 \u0627\u0644\u0645\u062e\u0635\u0635"
    },
    "account_id": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062d\u0633\u0627\u0628 / \u0627\u0644\u0645\u0634\u062a\u0631\u0643"
    },
    "subscriber_name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062c\u0651\u0644"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "duration_months": {
      "type": "number",
      "default": 12,
      "title": "\u0645\u062f\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 (\u0623\u0634\u0647\u0631)"
    },
    "annual_cost": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 (\u0631\u064a\u0627\u0644)"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "title": "\u062a\u062c\u062f\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a"
    },
    "not_applicable": {
      "type": "boolean",
      "default": false,
      "title": "\u0644\u0627 \u062a\u0646\u0637\u0628\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "document_url": {
      "type": "string",
      "title": "\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 / \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 (\u0631\u0627\u0628\u0637)"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "unified_number": {
      "type": "string",
      "title": "الرقم الوطني الموحد للمنشأة"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u064f\u0641\u0648\u0651\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "platform_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}