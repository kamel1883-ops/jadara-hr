{
  "name": "AccountDeletionRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0645\u0648\u0638\u0641 \u0635\u0627\u062d\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    },
    "requested_at": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0644\u0628"
    },
    "requested_via": {
      "type": "string",
      "enum": [
        "portal",
        "company"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "default": "portal",
      "title": "\u0645\u0635\u062f\u0631 \u0627\u0644\u0637\u0644\u0628 \u2014 portal \u0645\u0646 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u0648\u0638\u0641\u060c company \u0645\u0646 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pending",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u2014 pending \u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0625\u062a\u0644\u0627\u0641 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629\u060c done \u062a\u0645 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u060c rejected \u0645\u0631\u0641\u0648\u0636"
    },
    "note": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0645\u0642\u062f\u0651\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "processed_by": {
      "type": "string",
      "title": "\u0646\u064f\u0641\u0651\u0630 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "processed_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0646\u0641\u064a\u0630"
    }
  },
  "required": [
    "employee_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}