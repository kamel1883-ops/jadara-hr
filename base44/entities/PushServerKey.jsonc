{
  "name": "PushServerKey",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    },
    "public_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d VAPID \u0627\u0644\u0639\u0627\u0645"
    },
    "private_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d VAPID \u0627\u0644\u062e\u0627\u0635 (\u0644\u0627 \u064a\u062e\u0631\u062c \u0644\u0644\u0648\u0627\u062c\u0647\u0629)"
    },
    "subject": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0641\u064a \u0645\u0641\u062a\u0627\u062d VAPID"
    }
  },
  "required": [
    "public_key",
    "private_key"
  ],
  "rls": {
