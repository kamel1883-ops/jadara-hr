{
  "name": "CustomerSurvey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0627\u0633\u062a\u0628\u064a\u0627\u0646"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641 / \u0627\u0644\u0645\u0642\u062f\u0645\u0629",
      "maxLength": 500
    },
    "questions": {
      "type": "string",
      "title": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629 (JSON \u2014 \u062d\u062a\u0649 5 \u0623\u0633\u0626\u0644\u0629 \u062a\u0642\u064a\u064a\u0645)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629 \u0628\u0635\u064a\u063a\u0629 JSON: [{\"text\":\"\u0627\u0644\u0633\u0624\u0627\u0644\"}]"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "responses_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0631\u062f\u0648\u062f"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u0643"
    },
    "unified_number": {
      "type": "string",
      "title": "الرقم الوطني الموحد للمنشأة"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u064f\u0641\u0648\u0651\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}