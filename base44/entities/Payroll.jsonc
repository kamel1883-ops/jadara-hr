{
  "name": "Payroll",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "emp_ref": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0627\u0644\u062e\u0632\u0646\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u2014 \u0645\u0631\u062c\u0639 \u0645\u0639\u062a\u0645 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0633\u0629 (\u064a\u064f\u062c\u0644\u0628 \u0645\u0646\u0647 national_id \u0639\u0646\u062f \u0627\u0644\u0639\u0631\u0636/\u0627\u0644\u062a\u0635\u062f\u064a\u0631)"
    },
    "national_id": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u0648\u064a\u0629 / \u0627\u0644\u0625\u0642\u0627\u0645\u0629",
      "description": "\u0644\u0642\u0637\u0629 \u0648\u0642\u062a \u0627\u0644\u0625\u0646\u0634\u0627\u0621. \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062e\u0632\u0646\u0629: \u062a\u064f\u062a\u0631\u0643 \u0641\u0627\u0631\u063a\u0629 \u0648\u064a\u064f\u062c\u0644\u0628 national_id \u0645\u0646 \u0627\u0644\u062e\u0632\u0646\u0629 \u0639\u0628\u0631 emp_ref \u0639\u0646\u062f \u0627\u0644\u0639\u0631\u0636/\u062a\u0635\u062f\u064a\u0631 \u0645\u062f\u062f."
    },
    "month": {
      "type": "number",
      "title": "\u0627\u0644\u0634\u0647\u0631"
    },
    "year": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0646\u0629"
    },
    "batch": {
      "type": "number",
      "default": 1,
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062f\u0641\u0639\u0629 (\u0627\u0644\u0645\u0633\u064a\u0631) \u062f\u0627\u062e\u0644 \u0627\u0644\u0634\u0647\u0631 \u2014 1 \u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u0623\u0648\u0644\u0649\u060c 2 \u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0644\u0644\u0645\u0633\u062a\u062b\u0646\u064a\u0646"
    },
    "salary_payment_method": {
      "type": "string",
      "enum": [
        "mudad",
        "cash"
      ],
      "default": "mudad",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0635\u0631\u0641 (\u0645\u062f\u062f / \u0643\u0627\u0634) \u2014 \u0644\u0642\u0637\u0629 \u0645\u0646 \u0645\u0644\u0641 \u0627\u0644\u0645\u0648\u0638\u0641 \u0639\u0646\u062f \u0627\u0644\u062a\u0648\u0644\u064a\u062f"
    },
    "base_salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a"
    },
    "housing_allowance": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644 \u0627\u0644\u0633\u0643\u0646"
    },
    "transport_allowance": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644 \u0627\u0644\u0645\u0648\u0627\u0635\u0644\u0627\u062a"
    },
    "other_allowances": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644\u0627\u062a \u0623\u062e\u0631\u0649"
    },
    "gross_salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a"
    },
    "bonus": {
      "type": "number",
      "default": 0,
      "title": "\u062d\u0627\u0641\u0632"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0,
      "title": "\u0633\u0627\u0639\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "overtime_amount": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0625\u0636\u0627\u0641\u064a (Overtime)"
    },
    "loan_installment": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u0633\u0637 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "deductions": {
      "type": "number",
      "default": 0,
      "title": "\u062e\u0635\u0648\u0645\u0627\u062a \u0623\u062e\u0631\u0649"
    },
    "gosi_employee": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0623\u0645\u064a\u0646\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "gosi_employer": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0623\u0645\u064a\u0646\u0627\u062a \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0645\u0644"
    },
    "absent_days": {
      "type": "number",
      "default": 0,
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u063a\u064a\u0628"
    },
    "absent_hours": {
      "type": "number",
      "default": 0,
      "title": "\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u062a\u063a\u064a\u0628 (\u0646\u0642\u0635 \u0639\u0646 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645)"
    },
    "absent_deduction": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u064a\u0645\u0629 \u062e\u0635\u0645 \u0627\u0644\u062a\u063a\u0627\u0628 (\u0623\u064a\u0627\u0645 + \u0633\u0627\u0639\u0627\u062a) \u2014 \u0644\u0644\u0639\u0631\u0636 \u0641\u064a \u0627\u0644\u0643\u0634\u0641 \u0648\u0627\u0644\u0637\u0628\u0627\u0639\u0629"
    },
    "include_in_payroll": {
      "type": "boolean",
      "default": true,
      "title": "\u0645\u0634\u0645\u0648\u0644 \u0641\u064a \u0635\u0631\u0641 \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631 (\u2713 \u062a\u0634\u0645\u0644 / \u2717 \u062a\u0633\u062a\u062b\u0646\u0649)"
    },
    "net_salary": {
      "type": "number",
      "title": "\u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0627\u062a\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "paid"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0635\u0631\u0641"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651 \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0643\u0634\u0641"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651 \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629) \u2014 \u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0643\u0634\u0641"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "employee_id",
    "month",
    "year",
    "net_salary",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}