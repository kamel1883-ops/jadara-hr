{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "plate_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0644\u0648\u062d\u0629 (\u0639\u0631\u0628\u064a)"
    },
    "plate_number_en": {
      "type": "string",
