    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan",
        "suv",
        "van",
        "truck",
        "bus",
        "other"
      ],
      "default": "sedan",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629"
    },
    "brand": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0627\u0631\u0643\u0629 (\u0639\u0631\u0628\u064a)"
    },
    "brand_en": {
      "type": "string",
      "title": "Brand (English)"
    },
    "model": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u062f\u064a\u0644 (\u0639\u0631\u0628\u064a)"
    },
    "model_en": {
      "type": "string",
      "title": "Model (English)"
    },
    "year": {
      "type": "number",
      "title": "\u0633\u0646\u0629 \u0627\u0644\u0635\u0646\u0639"
    },
    "color": {
      "type": "string",
      "title": "\u0627\u0644\u0644\u0648\u0646"
    },
    "assigned_to": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0629"
    },
    "insurance_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0623\u0645\u064a\u0646"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062a\u0623\u0645\u064a\u0646"
    },
    "license_expiry": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0646\u062a\u0647\u0627\u0621 \u0631\u062e\u0635\u0629 \u0627\u0644\u0633\u064a\u0631"
    },
    "inspection_expiry": {
      "type": "string",
      "format": "date",
