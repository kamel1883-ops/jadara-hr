{
  "name": "NitaqatCatalog",
  "type": "object",
  "properties": {
    "source_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0631\u0633\u0645\u064a (\u0645\u0646\u0635\u0629 \u0642\u0648\u0649 / \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629)"
    },
    "source_url": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0631\u0633\u0645\u064a"
    },
    "fetched_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0622\u062e\u0631 \u0645\u0632\u0627\u0645\u0646\u0629 (ISO)"
    },
    "checksum": {
      "type": "string",
      "title": "\u0628\u0635\u0645\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u2014 \u0644\u0643\u0634\u0641 \u0623\u064a \u062a\u063a\u064a\u064a\u0631 \u0641\u064a \u0627\u0644\u0646\u0633\u0628 \u0645\u0646 \u0627\u0644\u0645\u0635\u062f\u0631"
    },
    "activities_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u0627\u0644\u0645\u064f\u0632\u0627\u0645\u064e\u0646\u0629"
    },
    "groups_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "unchanged",
        "failed",
        "bundled"
      ],
      "default": "ok",
      "title": "\u062d\u0627\u0644\u0629 \u0622\u062e\u0631 \u0645\u0632\u0627\u0645\u0646\u0629"
    },
    "error": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 (\u0625\u0646 \u0648\u064f\u062c\u062f)"
    },
    "payload": {
      "type": "string",
      "title": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0646\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629 (JSON: groups + activities \u0628\u0645\u0639\u0627\u0645\u0644\u0627\u062a\u0647\u0627)"
    }
  },
  "required": [
    "status"
  ],
