{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "emp_ref": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0627\u0644\u062e\u0632\u0646\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u2014 \u0645\u0631\u062c\u0639 \u0645\u0639\u062a\u0645 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0633\u0629 (\u064a\u064f\u062c\u0644\u0628 \u0645\u0646\u0647 national_id \u0639\u0646\u062f \u0627\u0644\u0639\u0631\u0636)"
    },
    "national_id": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u0648\u064a\u0629 / \u0627\u0644\u0625\u0642\u0627\u0645\u0629",
      "description": "\u0644\u0642\u0637\u0629 \u0648\u0642\u062a \u0627\u0644\u0625\u0646\u0634\u0627\u0621. \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062e\u0632\u0646\u0629: \u062a\u064f\u062a\u0631\u0643 \u0641\u0627\u0631\u063a\u0629 \u0648\u064a\u064f\u062c\u0644\u0628 national_id \u0645\u0646 \u0627\u0644\u062e\u0632\u0646\u0629 \u0639\u0628\u0631 emp_ref \u0639\u0646\u062f \u0627\u0644\u0639\u0631\u0636."
    },
    "branch_id": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u0631\u0639"
    },
    "branch_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u0639"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e"
    },
    "check_in": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062d\u0636\u0648\u0631"
    },
    "check_out": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0627\u0646\u0635\u0631\u0627\u0641"
    },
    "check_in_at": {
      "type": "number",
      "title": "\u0644\u062d\u0638\u0629 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062d\u0636\u0648\u0631 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 (timestamp \u0628\u0627\u0644\u0645\u0644\u064a \u062b\u0627\u0646\u064a\u0629)"
    },
    "check_out_at": {
      "type": "number",
      "title": "\u0644\u062d\u0638\u0629 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0627\u0646\u0635\u0631\u0627\u0641 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 (timestamp \u0628\u0627\u0644\u0645\u0644\u064a \u062b\u0627\u0646\u064a\u0629)"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "leave",
        "holiday"
      ],
      "default": "present",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "work_hours": {
      "type": "number",
      "title": "\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 (\u0635\u0627\u0641\u064a\u0629 \u0628\u0639\u062f \u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062d\u0627\u062a)"
    },
    "break_start": {
      "type": "string",
      "title": "\u0628\u062f\u0621 \u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062d\u0629 (HH:MM)"
    },
    "break_minutes": {
      "type": "number",
      "default": 0,
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u062f\u0642\u0627\u0626\u0642 \u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062d\u0629"
    },
    "break_log": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062d\u0627\u062a (JSON)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629: [{\"start\":\"HH:MM\",\"end\":\"HH:MM\",\"minutes\":N}]"
    },
    "source": {
      "type": "string",
      "enum": [
        "portal",
        "manual",
        "import"
      ],
      "default": "manual",
      "title": "\u0645\u0635\u062f\u0631 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u064f\u0641\u0648\u0651\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "employee_id",
    "date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}