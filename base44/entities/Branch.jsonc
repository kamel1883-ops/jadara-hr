      "type": "boolean",
      "default": false,
      "title": "\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0631\u0626\u064a\u0633\u064a"
    },
    "city": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
