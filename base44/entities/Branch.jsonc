      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "phone": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "logo_url": {
      "type": "string",
      "title": "\u0634\u0639\u0627\u0631 \u0627\u0644\u0641\u0631\u0639"
    },
    "lat": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0639\u0631\u0636 \u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0628\u0635\u0645\u0629"
    },
    "lng": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0637\u0648\u0644 \u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0628\u0635\u0645\u0629"
    },
    "radius": {
      "type": "number",
      "default": 50,
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0628\u0635\u0645\u0629 (\u0645\u062a\u0631)"
    },
    "custom_hours": {
      "type": "boolean",
      "default": false,
      "title": "\u0627\u0644\u0641\u0631\u0639 \u0644\u062f\u064a\u0647 \u0633\u0627\u0639\u0627\u062a \u0639\u0645\u0644 \u062e\u0627\u0635\u0629 \u062a\u064f\u0639\u062a\u0645\u062f \u0641\u064a \u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0627\u0644\u0627\u0646\u0635\u0631\u0627\u0641 \u0648\u0627\u0644\u0631\u0648\u0627\u062a\u0628"
    },
    "work_start_time": {
      "type": "string",
      "title": "\u0628\u062f\u0627\u064a\u0629 \u062f\u0648\u0627\u0645 \u0627\u0644\u0641\u0631\u0639 (HH:MM) \u2014 \u062a\u064f\u0639\u062a\u0645\u062f \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062e\u0627\u0635\u0629"
    },
    "work_end_time": {
      "type": "string",
      "title": "\u0646\u0647\u0627\u064a\u0629 \u062f\u0648\u0627\u0645 \u0627\u0644\u0641\u0631\u0639 (HH:MM) \u2014 \u062a\u064f\u0639\u062a\u0645\u062f \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062e\u0627\u0635\u0629"
    },
    "work_hours_per_day": {
      "type": "number",
      "default": 0,
      "title": "\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0644\u0644\u0641\u0631\u0639"
    },
    "late_grace_minutes": {
      "type": "number",
      "default": 15,
      "title": "\u0633\u0645\u0627\u062d \u0627\u0644\u062a\u0623\u062e\u064a\u0631 \u0644\u0644\u0641\u0631\u0639 (\u062f\u0642\u064a\u0642\u0629)"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "required": [
