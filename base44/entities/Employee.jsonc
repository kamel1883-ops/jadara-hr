    "permissions": {
      "type": "string",
      "title": "\u0645\u0635\u0641\u0648\u0641\u0629 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a (JSON \u2014 \u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0628\u0647\u0627)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629 JSON: [\"employees\",\"attendance\",...] \u2014 \u062a\u0648\u062b\u064a\u0642\u064a\u0629 \u0641\u0642\u0637: \u062a\u0633\u062c\u0651\u0644 \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u064a \u064a\u064f\u062d\u0642 \u0644\u0644\u0645\u0648\u0638\u0641 \u0641\u062a\u062d\u0647\u0627\u060c \u062f\u0648\u0646 \u062a\u0641\u0639\u064a\u0644 \u0645\u0646\u0639 \u0641\u0639\u0644\u064a."
    }
  },
  "required": [
    "employee_number",
    "department",
    "position",
    "hire_date",
    "base_salary"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}