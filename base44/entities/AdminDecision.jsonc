{
  "name": "AdminDecision",
  "type": "object",
  "properties": {
    "decision_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0642\u0631\u0627\u0631"
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "appointment",
        "transfer",
        "promotion",
        "assignment",
        "secondment",
        "exemption",
        "reward",
        "deduction",
        "warning",
        "termination",
        "policy",
        "other"
      ],
      "default": "other",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0642\u0631\u0627\u0631"
    },
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0642\u0631\u0627\u0631 (\u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629)"
    },
    "body": {
      "type": "string",
      "title": "\u0646\u0635 \u0627\u0644\u0642\u0631\u0627\u0631 (\u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629)",
      "maxLength": 6000
    },
    "i18n": {
      "type": "string",
      "title": "\u062a\u0631\u062c\u0645\u0627\u062a \u0627\u0644\u0639\u0646\u0648\u0627\u0646/\u0627\u0644\u0646\u0635 (JSON 7 \u0644\u063a\u0627\u062a)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629 JSON: {\"title\":{ar,en,hi,ne,bn,fil,ur},\"body\":{...}}"
    },
    "target": {
      "type": "string",
      "enum": [
        "all",
        "department",
        "employee"
      ],
      "default": "all",
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629 (\u0639\u0646\u062f \u0646\u0637\u0627\u0642 \u0642\u0633\u0645)"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 (\u0639\u0646\u062f \u0646\u0637\u0627\u0642 \u0641\u0631\u062f)"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "issued_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0641\u0627\u0630"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "archived"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "created_by_name": {
      "type": "string",
      "title": "\u0623\u0635\u062f\u0631\u0647 / \u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645)"
    },
    "created_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    },
    "acknowledged_log": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 (JSON)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629: [{\"employee_id\",\"date\"}]"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}