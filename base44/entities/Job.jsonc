{
  "name": "Job",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "profession": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0647\u0646\u0629"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract"
      ],
      "default": "full_time",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0648\u0638\u064a\u0641\u0629"
    },
    "grade": {
      "type": "string",
      "title": "\u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629"
    },
    "salary": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 (\u0631\u064a\u0627\u0644)"
    },
    "nationality_req": {
      "type": "string",
      "enum": [
        "any",
        "saudi",
        "resident"
      ],
      "default": "any",
      "title": "\u0627\u0644\u0645\u0637\u0644\u0648\u0628"
    },
    "qualifications": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0624\u0647\u0644\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "tasks": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0647\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0627\u062a"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641 \u0627\u0644\u0648\u0638\u064a\u0641\u064a (Job Description)",
      "maxLength": 10000
    },
    "vacancy_count": {
      "type": "number",
      "default": 1,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0634\u0648\u0627\u063a\u0631"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "hired_applicant_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0639\u064a\u0651\u0646"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0634\u0631"
    },
    "closed_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u063a\u0644\u0627\u0642"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651 \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0641\u0648\u0636 \u0627\u0644\u0630\u064a \u0623\u0646\u0634\u0623/\u0639\u062f\u0651\u0644 \u0627\u0644\u0648\u0638\u064a\u0641\u0629"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651 \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0641\u0648\u0636"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
