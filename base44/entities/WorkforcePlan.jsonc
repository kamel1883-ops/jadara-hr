{
  "name": "WorkforcePlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062e\u0637\u0629"
    },
    "plan_year": {
      "type": "number",
      "title": "\u0633\u0646\u0629 \u0627\u0644\u062e\u0637\u0629"
    },
    "planning_horizon": {
      "type": "string",
      "enum": [
        "annual",
        "multi_year",
        "rolling"
      ],
      "default": "annual",
      "title": "\u0623\u0641\u0642 \u0627\u0644\u062a\u062e\u0637\u064a\u0637"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629 / \u0627\u0644\u062c\u0647\u0629"
    },
    "objective": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u062f\u0641"
    },
    "current_headcount": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0639\u062f\u062f \u0627\u0644\u062d\u0627\u0644\u064a"
    },
    "target_headcount": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641"
    },
    "recruitment_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u062a\u0639\u064a\u064a\u0646\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "training_count": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u062a\u062f\u0631\u064a\u0628"
    },
    "budget": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u0639\u0627\u0645\u0644\u0629"
    },
    "initiatives": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0627\u062a"
    },
    "kpis": {
      "type": "string",
      "title": "\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0623\u062f\u0627\u0621"
    },
    "owner_name": {
      "type": "string",
      "title": "\u0645\u0627\u0644\u0643 \u0627\u0644\u062e\u0637\u0629"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0647\u0627\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "in_progress",
        "completed"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0641\u0648\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    }
  },
  "required": [
    "title",
    "plan_year",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}