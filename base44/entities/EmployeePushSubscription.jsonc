{
  "name": "EmployeePushSubscription",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u0651\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629 (\u0646\u0637\u0627\u0642 \u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a)"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0633\u062c\u0644 \u0627\u0644\u0645\u0648\u0638\u0641 (\u0627\u0644\u0647\u0648\u064a\u0629)"
    },
    "endpoint": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0634\u062a\u0631\u0627\u0643 \u0627\u0644\u062f\u0641\u0639 (endpoint)"
    },
    "p256dh": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0639\u0627\u0645 p256dh"
    },
    "auth": {
      "type": "string",
      "title": "\u0633\u0631 \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0644\u0644\u062c\u0647\u0627\u0632 auth"
    },
    "user_agent": {
      "type": "string",
      "title": "\u062c\u0647\u0627\u0632/\u0645\u062a\u0635\u0641\u062d \u0627\u0644\u0645\u0648\u0638\u0641 \u0639\u0646\u062f \u0627\u0644\u062a\u0641\u0639\u064a\u0644"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "\u0627\u0634\u062a\u0631\u0627\u0643 \u0641\u0639\u0651\u0627\u0644"
    },
    "subscribed_at": {
      "type": "number",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062a\u0641\u0639\u064a\u0644 (timestamp ms)"
    }
  },
  "required": [
    "unified_number",
    "employee_id",
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}