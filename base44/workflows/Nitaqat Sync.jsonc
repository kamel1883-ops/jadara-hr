          "x-base44": {
            "title": "\u0645\u0632\u0627\u0645\u0646\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0646\u0637\u0627\u0642\u0627\u062a",
            "description": "\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0645\u0646 \u0645\u0646\u0635\u0629 \u0642\u0648\u0649"
          }
