{
  "name": "Tamm Vehicle Sync",
  "description": "\u0645\u0632\u0627\u0645\u0646\u0629 \u0623\u0633\u0628\u0648\u0639\u064a\u0629 (\u0643\u0644 \u0633\u0628\u062a 8 \u0635\u0628\u0627\u062d\u0627\u064b) \u0644\u062a\u0648\u0627\u0631\u064a\u062e \u0631\u062e\u0635\u0629 \u0627\u0644\u0633\u064a\u0631 \u0648\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0641\u062d\u0635 \u0627\u0644\u062f\u0648\u0631\u064a \u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0645\u0646 \u0645\u0646\u0635\u0629 \u00ab\u062a\u0645\u00bb \u0639\u0628\u0631 \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0641\u0642\u0637\u060c \u062b\u0645 \u062a\u062a\u062d\u062f\u062b \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0645\u0646 \u0622\u062e\u0631 \u062a\u0648\u0627\u0631\u064a\u062e \u0645\u062d\u062f\u062b\u0629.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 6",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tamm_vehicle_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "vehicleSync",
            "args": {
              "action": "syncAll"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0645\u0632\u0627\u0645\u0646\u0629 \u0645\u0631\u0643\u0628\u0627\u062a \u00ab\u062a\u0645\u00bb",
            "description": "\u0643\u0644 \u0633\u0628\u062a 8 \u0635\u0628\u0627\u062d\u0627\u064b \u2014 \u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u062a\u0648\u0627\u0631\u064a\u062e \u0631\u062e\u0635\u0629 \u0627\u0644\u0633\u064a\u0631 \u0648\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0641\u062d\u0635 \u0644\u0643\u0644 \u0645\u0631\u0643\u0628\u0629 \u0645\u0633\u062a\u062d\u0642\u0629 (\u0628\u062d\u062f \u0645\u0631\u0629 \u0643\u0644 7 \u0623\u064a\u0627\u0645 \u0644\u0644\u0645\u0631\u0643\u0628\u0629)"
          }
        }
      }
    ]
  }
}